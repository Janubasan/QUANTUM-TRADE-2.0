//@version=5
// ═══════════════════════════════════════════════════════════════════
// QUANTUM MIRROR #4 — Quant-Bot ORB & Monte Carlo (15m)
// Win 58.9% • Sharpe 0.28 • TP 2.5R / SL 1R • risco 0.4%
// Opening range dos primeiros 15 min + gate Monte Carlo (servidor).
// Alerta → POST https://SEU-HOST/tv/webhook com a Message abaixo.
// ── ALERT MESSAGE (colar no TradingView) ──
// {"secret":"quantum_mirror_tv_secret_2026","bot_id":"orb-mc-15m","symbol":"BTC/USDT","action":"{{strategy.order.action}}","price":{{close}},"timeframe":"15m","order_id":"TV-orb-{{timenow}}","timestamp":{{timenow}}}
// ═══════════════════════════════════════════════════════════════════
strategy("QM #4 ORB Monte Carlo 15m", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=4)

orbMins  = input.int(15, "Opening range (min)")
volLen   = input.int(20, "MM Volume")
volMult  = input.float(1.2, "Volume mínimo x")
tpR      = input.float(2.5, "TP (R)")

isNewDay = ta.change(time("D")) != 0
var float orbH = na
var float orbL = na
// Primeira barra do dia = opening range
if isNewDay
    orbH := high
    orbL := low

vma = ta.sma(volume, volLen)
volOk = volume >= vma * volMult

longSig  = not na(orbH) and close > orbH and volOk and not isNewDay
shortSig = not na(orbL) and close < orbL and volOk and not isNewDay

riskMin = close * 0.004
if longSig
    risk = math.max(close - orbL, riskMin)
    strategy.entry("L", strategy.long)
    strategy.exit("LX", "L", profit=risk * tpR, loss=risk)
if shortSig
    risk = math.max(orbH - close, riskMin)
    strategy.entry("S", strategy.short)
    strategy.exit("SX", "S", profit=risk * tpR, loss=risk)

plot(orbH, "ORB High", color.teal, 2, plot.style_linebr)
plot(orbL, "ORB Low", color.red, 2, plot.style_linebr)
plotshape(longSig, style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.small)
plotshape(shortSig, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)
alertcondition(longSig, "QM ORB Long", "LONG orb")
alertcondition(shortSig, "QM ORB Short", "SHORT orb")
