# ============================================================================
# GEMINI / APP
# ============================================================================
# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ============================================================================
# WFA VALIDATION / ALPACA PAPER
# ============================================================================
# Optional for historical data. Without these keys the WFA engine uses Yahoo
# Finance as a real-data fallback, never synthetic candles.
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_DATA_FEED="iex"
ALPACA_DATA_URL="https://data.alpaca.markets"
# The promotion gate consults this endpoint and never promotes to LIVE.
ALPACA_PAPER_BASE_URL="https://paper-api.alpaca.markets"
# Optional path for the approved, PAPER-only deployment manifest.
VALIDATED_STRATEGY_PATH="server/data/validated_strategy.json"
VALIDATION_REPORT_PATH="server/data/validation/last_pipeline.json"
# false by default: legacy simulated worker never wakes the paper deployment.
ENABLE_LEGACY_BOT_WORKER="false"
# Even with an approved manifest, the Node heartbeat requires explicit opt-in.
ENABLE_PAPER_RUNNER="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Porta HTTP do servidor Express (padrão 3000).
PORT="3000"

# ============================================================================
# SEGURANÇA — cofre e webhooks
# ============================================================================
# Chave mestra do cofre AES-256-GCM. TROQUE antes de qualquer uso real:
# qualquer pessoa com esta chave consegue decriptar as credenciais do cofre.
ENCRYPTION_KEY="quantum_master_vault_aes_256_key_2026_prod"

# Segredo HMAC-SHA256 dos webhooks (TradingView / bridges).
WEBHOOK_SECRET="STOCKRAFT_QUANTUM_SECRET_2026"

# ============================================================================
# MetaTrader 5 (bridge Python FastAPI mt5_executor.py)
# ============================================================================
MT5_BRIDGE_URL="http://localhost:8000"
MT5_HMAC_SECRET="quantum_mt5_bridge_secret_2026"

# ============================================================================
# Binance (Spot & Futures USD-M)
# ============================================================================
BINANCE_API_KEY=""
BINANCE_API_SECRET=""
BINANCE_USE_TESTNET="true"

# ============================================================================
# cTrader Open API / IC Markets
# ============================================================================
CTRADER_CLIENT_ID=""
CTRADER_CLIENT_SECRET=""
CTRADER_ACCOUNT_ID="demo-ctrader-88219"

# ============================================================================
# ⛓️  BLOCKCHAIN EVM — EXECUÇÃO ON-CHAIN REAL
#     Guia completo: docs/GUIA_INTEGRACAO_BLOCKCHAIN.md
# ============================================================================

# ---- Carteira ------------------------------------------------------------
# Chave privada da carteira DEDICADA de operação. Nunca use a sua principal.
# Aceita texto puro ("0xabc...") ou cifrado no formato do cofre ("vault:v1:...").
# Deixe VAZIO até o passo 4 do guia.
EVM_PRIVATE_KEY=""

# ---- Rede ativa ----------------------------------------------------------
# Padrão é a TESTNET Sepolia: o primeiro contato nunca é com dinheiro real.
# Opções: sepolia | base_sepolia | arbitrum_sepolia | bsc_testnet
#         polygon | bsc | arbitrum | base | avalanche | ethereum | optimism
DEFAULT_CHAIN="sepolia"

# ---- Travas de segurança (NÃO altere sem ler o guia) ---------------------
# true  = permite operar em MAINNET (dinheiro real).
# false = mainnet é recusada mesmo com confirm=true. Padrão seguro: false.
ONCHAIN_ALLOW_LIVE="false"

# Teto aproximado por operação, em unidades do token de saída.
# É um teto bruto (não usa oráculo de preço): melhor pequeno do que ausente.
ONCHAIN_MAX_NOTIONAL_USD="1000"

# Confirmações aguardadas antes de reportar CONFIRMED.
ONCHAIN_CONFIRMATIONS="1"

# false (padrão) = aprova ao router apenas o valor exato da operação.
# true  = aprovação infinita. Economiza gas, mas deixa o router com acesso
#         permanente ao saldo. Só use se souber o que está fazendo.
ONCHAIN_INFINITE_APPROVAL="false"

# true = força roteamento A -> WrappedNative -> B mesmo havendo par direto.
ONCHAIN_FORCE_MULTIHOP="false"

# ---- Endpoints RPC -------------------------------------------------------
# Opcional. Quando definido, é usado COM PRIORIDADE sobre os públicos,
# que continuam na lista como fallback automático.
# Recomenda-se um RPC próprio (Alchemy/Infura/QuickNode) em produção:
# RPC público aplica rate limit e cai.
RPC_SEPOLIA=""
RPC_BASE_SEPOLIA=""
RPC_ARBITRUM_SEPOLIA=""
RPC_BSC_TESTNET=""
RPC_POLYGON=""
RPC_BSC=""
RPC_ARBITRUM=""
RPC_BASE=""
RPC_AVALANCHE=""
RPC_ETHEREUM=""
RPC_OPTIMISM=""

# ---- Routers de DEX (opcional) -------------------------------------------
# A tabela interna já traz os routers das redes principais, e o endpoint
# POST /api/onchain/verify os confere ON-CHAIN antes de qualquer swap.
# Defina aqui apenas para sobrescrever — ex.: a OP Mainnet não vem
# configurada porque usa Velodrome, que não é compatível com a ABI Uniswap V2.
DEX_ROUTER_OPTIMISM=""

# ---- Tokens adicionais (opcional) ----------------------------------------
# Formato: TOKEN_<REDE>_<SIMBOLO>=0x<contrato>
# Rede em maiúsculas, símbolo em maiúsculas. Exemplos:
# TOKEN_SEPOLIA_TST="0x..."
# TOKEN_POLYGON_MYTOKEN="0x..."

# ---- Trilha de auditoria -------------------------------------------------
# Diretório dos arquivos JSONL append-only da trilha de auditoria.
AUDIT_DIR=""

# Contrato opcional com `anchor(bytes32)` para ancorar o hash da auditoria.
# Vazio = ancora via transação de valor zero com o hash no calldata
# (mais barato e não exige deploy).
AUDIT_ANCHOR_CONTRACT=""
