# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# EXECUTION SAFETY — values here are placeholders only. Never commit .env files.
# The current broker adapters are simulated. See docs/ROADMAP_INTEGRACOES_REAIS.md
# before implementing or enabling a real provider.
# -----------------------------------------------------------------------------
EXECUTION_DEFAULT_MODE="paper"
LIVE_EXECUTION_ENABLED="false"
LIVE_EXECUTION_CONFIRMATION=""
INTEGRITY_HMAC_SECRET=""

# Coinbase Advanced Trade — server-side Secret Manager only; begin in sandbox.
# Confirm the credential format against the current official API documentation.
COINBASE_ENVIRONMENT="sandbox"
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# EVM — server-side only. Start on Sepolia. Never expose RPC credentials or a
# private key to the browser; use a secret reference/KMS in production.
WEB3_NETWORK="sepolia"
SEPOLIA_RPC_URL=""
ETH_RPC_URL=""
BOT_WALLET_PRIVATE_KEY=""

# B3 — only after the selected partner has formally homologated the integration.
B3_BROKER_SELECTED=""
B3_ENVIRONMENT="homologacao"
B3_CREDENTIAL_REF=""
